# contract-harness YAML 配置文件
# 使用方式: harness -c harness.yaml
#
# 支持 ${VAR_NAME} 和 ${VAR_NAME:-default} 环境变量引用语法
# 不指定的字段使用默认值（走环境变量回退）

# ============================================================
# LLM 配置
# ============================================================
llm:
  provider: openai                     # LLM 供应商（openai / deepseek 等）
  model: gpt-4o-mini                   # 模型名
  api_key: ${OPENAI_API_KEY:-}         # API 密钥，默认读取 OPENAI_API_KEY
  api_base: ${OPENAI_API_BASE:-}       # API 地址，默认 https://api.openai.com/v1
  proxy: ${HTTP_PROXY:-}               # 代理地址
  max_retries: 3                       # 请求重试次数

# ============================================================
# Embedding 配置
# ============================================================
embedding:
  provider: openai                     # Embedding 供应商
  model: text-embedding-3-small        # Embedding 模型
  api_key: ${EMBEDDING_API_KEY:-}      # 默认同 OPENAI_API_KEY
  api_base: ${EMBEDDING_API_BASE:-}    # 默认同 OPENAI_API_BASE
  proxy: ${HTTP_PROXY:-}               # 代理地址
  enable_hybrid_search: false          # 启用混合检索（稠密+BM25+RRF）
  rrf_k: 60                            # RRF 融合参数
  max_rpm: 0                           # 每分钟最大请求数（0=不限）
  max_tpm: 0                           # 每分钟最大 Token 数（0=不限）
  rerank_provider: ""                  # Reranker 供应商（openai / local），空=禁用
  rerank_model: "rerank-v1"            # Reranker 模型
  rerank_api_key: ${RERANK_API_KEY:-}  # 默认同 OPENAI_API_KEY
  rerank_api_base: ${RERANK_API_BASE:-}# 默认同 OPENAI_API_BASE
  rerank_max_rpm: 0                    # Reranker 每分钟最大请求数（0=不限，Cohere 默认 2000）
  rerank_max_tpm: 0                    # Reranker 每分钟最大 Token 数（0=不限，Cohere 默认 500000）

# ============================================================
# 目录路径（默认基于 HARNESS_DATA_DIR，不设置则用项目下 .harness/）
# ============================================================
data_dir: ${HARNESS_DATA_DIR:-}
log_dir: ""                            # 日志目录
kb_dir: ""                             # 知识库目录
replay_dir: ""                         # 回放目录
eval_dir: ""                           # 评测目录
regression_dir: ""                     # 回归目录
report_dir: ""                         # 报告目录
memory_dir: ""                         # 记忆库目录

# ============================================================
# 功能开关
# ============================================================
agent_mode: pipeline                   # 审查模式：pipeline / react / reflection / multi_agent
use_docling: false                     # 使用 Docling 文档解析（需安装 docling）
memory_enabled: true                   # 启用持久化记忆
memory_top_k: 3                        # 记忆检索返回条数
verbose: false                         # 详细日志输出

# ============================================================
# 自动执行（可选）
# harness -c harness.yaml 不传子命令时自动运行此命令
# ============================================================
# run:
#   command: kb eval generate
#   arguments:
#     queries_per_chunk: 2
#     sample: 100
#     seed: 42
#     output: ".harness/data/rag_eval_dataset.jsonl"

