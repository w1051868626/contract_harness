# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
*.whl
*.manifest
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project — 运行时数据与日志
*.log
.output/
.harness/
.coverage
coverage.xml
htmlcov/

# 测试临时产物（根目录下 test* 目录/文件，不误伤 tests/ 源码）
/*test*
!tests/**

# 配置文件 — 本地覆盖与环境密钥
*.local.yaml
*.env
!example.env

# Debug / 分块测试临时产物
debug/
!debug/**/__init__.py

# 文档解析缓存（Docling / pypdf）
*.zip
*.docx
*.pdf

# 数据库与向量存储（ChromaDB sqlite 等）
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# 评测数据集生成产物（JSONL），跟踪示例/测试数据但忽略运行时生成
.harness/**/*.jsonl
.harness/**/*.json
laws_*.json

# 回归基线缓存
.regression_baseline/

# AtomCode — 仅忽略本地机器特定配置
.atomcode/local/

# MCP 配置 — 含 GitHub PAT 等密钥，禁止提交（ team 各自本地维护 ）
.mcp.json

# YAML 配置文件（已跟踪的 config.template.yaml / environment.yml 不受影响）
*.yaml
*.yml
