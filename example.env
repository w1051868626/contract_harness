# =====================================================
# contract-harness 环境变量
# =====================================================
# 复制此文件为 .env 并填入实际值即可生效
# 系统会自动读取同级 .env 文件（如已安装 python-dotenv）
# =====================================================

# --- LLM ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# 自定义供应商（provider = "deepseek" 时使用以下变量）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# LLM 代理（可选）
# HTTP_PROXY=http://127.0.0.1:7890

# --- Embedding ---
# 可单独指定 Embedding 的密钥和地址（默认复用 OPENAI_API_*）
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# --- 其他 ---
# HARNESS_VERBOSE=1
