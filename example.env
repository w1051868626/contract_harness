# =====================================================
# contract-harness 环境变量
# =====================================================
# 复制此文件为 .env 并填入实际值即可生效
# 系统会自动读取同级 .env 文件（如已安装 python-dotenv）
# =====================================================

# --- LLM ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# LLM 供应商（openai / deepseek / ollama / azure ...）
# LLM_PROVIDER=openai

# 自定义供应商（provider = "deepseek" 时使用以下变量）
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# LLM 代理（可选，默认回退 HTTP_PROXY）
# LLM_PROXY=http://127.0.0.1:7890

# --- Embedding ---
# 可单独指定 Embedding 的供应商、密钥、地址（默认复用 OPENAI_API_*）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=
# EMBEDDING_PROXY=

# --- ReRank ---
# RERANK_PROVIDER=openai
# RERANK_API_KEY=
# RERANK_API_BASE=
# RERANK_MODEL=rerank-v1

# --- AI 分块（默认复用 OPENAI_API_*） ---
# CHUNK_MODEL=gpt-4o-mini
# CHUNK_API_KEY=
# CHUNK_API_BASE=

# --- 通用代理（LLM / Embedding 未单独指定时的回退） ---
# HTTP_PROXY=http://127.0.0.1:7890

# --- 数据目录 ---
# 默认在项目根目录 .harness/ 下，可通过此变量自定义
# HARNESS_DATA_DIR=/path/to/data
