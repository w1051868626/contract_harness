# contract-harness 环境变量示例
# 复制此文件为 .env 并填入实际值

# === LLM 配置 ===
# OPENAI_API_KEY=sk-your-key-here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_PROXY=http://127.0.0.1:7890

# === Embedding 配置 ===
# EMBEDDING_API_KEY=sk-your-embedding-key
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MAX_RPM=2000
# EMBEDDING_MAX_TPM=500000

# === Reranker 配置 ===
# RERANK_PROVIDER=openai
# RERANK_API_KEY=sk-your-rerank-key
# RERANK_API_BASE=https://api.openai.com/v1
# RERANK_MODEL=rerank-v1

# === AI 分块配置 ===
# CHUNK_MODEL=gpt-4o-mini
# CHUNK_API_KEY=sk-your-chunk-key
# CHUNK_API_BASE=https://api.openai.com/v1

# === 混合检索 ===
# ENABLE_HYBRID_SEARCH=true

# === 数据目录 ===
# HARNESS_DATA_DIR=.harness

# === GitHub MCP（.mcp.json 的 github server 读此变量） ===
# GITHUB_PAT=github_pat_your_token_here
